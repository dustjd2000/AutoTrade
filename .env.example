# .env.example — 실제 값을 채워 .env 파일로 복사하세요 (git에 커밋 금지)

# 매매 모드: paper(모의) | live(실전). 실전은 실제 자금이 사용됩니다.
TRADE_MODE=paper

KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT=

# 이메일 — 발송/수신 주소만 UI에서 수정 가능. 서버·포트·비밀번호는 이 파일에서만 관리한다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
# Gmail은 계정 비밀번호가 아니라 "앱 비밀번호"(16자)를 발급받아 넣어야 한다
SMTP_PASSWORD=
EMAIL_FROM=your-account@gmail.com
EMAIL_TO=recipient@example.com

# 리스크 관리 — 익절/손절 라인 (단위: %, 수수료·세금·슬리피지를 뺀 순손익률 기준)
TAKE_PROFIT_PERCENT=2
STOP_LOSS_PERCENT=2

# 1호 전략 자금 배분 — 예수금 중 매매에 투입할 비율(%, 10~100 10단위)과 추천받을 종목 수(1~10)
INVESTABLE_RATIO_PERCENT=50
TARGET_STOCK_COUNT=3

# 1호 전략 LLM 추천 시각 (HH:MM) — 09:00 매수보다 앞서야 하므로 08:40~08:55(5분 단위)에서 고른다
RECOMMEND_TIME=08:45

# 익절/손절 판정에 반영할 비용 (단위: %)
COMMISSION_PERCENT=0.015   # 매매수수료 (매수·매도 동일 적용)
TAX_PERCENT=0.18           # 증권거래세+농특세 (매도 시만)
SLIPPAGE_PERCENT=0.1       # 시장가 청산 시 불리하게 밀리는 정도 추정치

# 장애 대응: 장중 예외 발생 시 "close_all"(포지션 정리 후 정지) | "hold"(정지만)
EMERGENCY_ACTION=hold

# LLM 연동 (1호 전략 — Anthropic Claude API)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# 실전 계좌 사용 시 이 값을 정확히 입력해야 시스템이 실행됩니다.
# LIVE_TRADE_CONFIRMED=YES_I_UNDERSTAND
