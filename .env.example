# .env.example — 실제 값을 채워 .env 파일로 복사하세요 (git에 커밋 금지)

# 매매 모드: paper(모의) | live(실전). 실전은 실제 자금이 사용됩니다.
TRADE_MODE=paper

KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT=

# 이메일 — 발송/수신 주소만 UI에서 수정 가능. 서버·포트·비밀번호는 이 파일에서만 관리한다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
# Gmail은 계정 비밀번호가 아니라 "앱 비밀번호"(16자)를 발급받아 넣어야 한다
SMTP_PASSWORD=
EMAIL_FROM=your-account@gmail.com
EMAIL_TO=recipient@example.com

# 리스크 관리 — 익절/손절 라인 (단위: %, 수수료·세금·슬리피지를 뺀 순손익률 기준)
# UI는 이 둘을 한 칸으로 다루며 항상 같은 값으로 저장한다 — 서로 다르게 적어 두면
# 익절 쪽 값이 UI에 뜨고, 저장하는 순간 손절 값이 그 값으로 덮인다
TAKE_PROFIT_PERCENT=2
STOP_LOSS_PERCENT=2

# 09:00 매수 직전 현재가가 목표 매수가보다 이 비율(%)을 넘게 높으면 그 종목을 건너뛴다.
# 갭 상승한 날 추격매수를 막는 장치다. 0으로 두면 목표가를 조금이라도 넘는 순간 건너뛴다.
BUY_PRICE_TOLERANCE_PERCENT=2

# 09:00 매수 직전 현재가가 전일 종가보다 이 비율(%)을 넘게 낮으면 그 종목을 건너뛴다.
# 기준이 목표 매수가가 아니라 전일 종가인 것에 주의 — 목표가 자체가 눌림을 노려 전일 종가보다
# 낮게 잡히므로, 목표가 기준으로는 얼마나 낮게 출발했는지가 잡히지 않는다.
# 위와 반대로 0이 '끔'이다 (임계값 근거가 아직 약해 꺼둘 수 있어야 한다).
GAP_DOWN_TOLERANCE_PERCENT=1

# 1호 전략 자금 배분 — 예수금 중 매매에 투입할 비율(%, 10~100 10단위)과 추천받을 종목 수(1~10)
INVESTABLE_RATIO_PERCENT=50
TARGET_STOCK_COUNT=3

# 1호 전략의 추천·매수 시각 (HH:MM) — UI에는 값만 표시되고, 바꾸려면 여기를 고친 뒤
# 프로그램을 다시 시작한다. 추천은 개장(09:00) 후여야 당일 지표가 오고, 매수는 추천보다
# 3분 이상 뒤여야 한다(수집 40초 + LLM 타임아웃 상한 120초). 어기면 엔진이 시작되지 않는다.
RECOMMEND_TIME=09:05
BUY_TIME=09:08

# 익절/손절 판정에 반영할 비용 (단위: %)
COMMISSION_PERCENT=0.015   # 매매수수료 (매수·매도 동일 적용)
TAX_PERCENT=0.18           # 증권거래세+농특세 (매도 시만)
SLIPPAGE_PERCENT=0.1       # 시장가 청산 시 불리하게 밀리는 정도 추정치

# 장애 대응: 장중 예외 발생 시 "close_all"(포지션 정리 후 정지) | "hold"(정지만)
EMERGENCY_ACTION=hold

# LLM 연동 (1호 전략 — Anthropic Claude API)
# 키는 UI "계좌 / API 설정"의 'Anthropic Key' 칸에서도 수정할 수 있다. 모델명은 이 파일 전용이다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# DART 전자공시 OpenAPI — opendart.fss.or.kr에서 무료 발급 (하루 20,000건 한도)
# 후보 종목의 공시 제목을 LLM 프롬프트에 싣고, 악재 공시가 뜬 종목을 후보에서 제외하는 데 쓴다.
# 비워두면 공시 없이 추천이 진행된다 (배제도 하지 않는다).
# UI "계좌 / API 설정"의 'DART Key' 칸에서도 수정할 수 있다.
DART_API_KEY=

# 실전 계좌 사용 시 이 값을 정확히 입력해야 시스템이 실행됩니다.
# LIVE_TRADE_CONFIRMED=YES_I_UNDERSTAND
