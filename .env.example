# .env.example — 실제 값을 채워 .env 파일로 복사하세요 (git에 커밋 금지)

# 매매 모드: paper(모의) | live(실전). 실전은 실제 자금이 사용됩니다.
TRADE_MODE=paper

KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT=

# 이메일 — 발송/수신 주소만 UI에서 수정 가능. 서버·포트·비밀번호는 이 파일에서만 관리한다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
# Gmail은 계정 비밀번호가 아니라 "앱 비밀번호"(16자)를 발급받아 넣어야 한다
SMTP_PASSWORD=
EMAIL_FROM=your-account@gmail.com
EMAIL_TO=recipient@example.com

# 리스크 관리 — 순손익 기준 손절선(%) (수수료·슬리피지를 뺀 순손익률 기준, ETF는 거래세 면제)
STOP_LOSS_PERCENT=2
# AI 매도 판단 프롬프트에 '고점 대비 반납' 수치를 실을 최소 고점(%) — 이보다 낮은 고점은 노이즈로 본다
AI_EXIT_DRAWDOWN_PERCENT=1
# AI 매도 판단 호출 단계 폭(%p) — 순손익률이 이 폭의 단계를 새로 넘을 때마다 부른다 (최소 0.1)
AI_EXIT_STEP_PERCENT=0.5
# 이번 달 순수익률(%)이 이 값 이상이면 15:40 매도 프롬프트 자동 수정을 건너뛴다 (1~10, 0.5 단위)
TUNE_SKIP_MONTHLY_RETURN_PERCENT=5

# 청산 경로 적용 여부 (1=켬 / 0=끔). UI 체크박스를 켜고 끌 때마다 이 파일에 저장되므로
# 프로그램을 다시 시작해도 마지막 상태가 그대로 이어진다. 값이 없거나 알 수 없으면 '켬'이다.
# AI 매도 판단은 순손익률이 AI_EXIT_STEP_PERCENT 폭의 단계를 새로 넘을 때마다 부른다. 둘 다 끄면 15:15 강제청산까지 보유한다.
AI_EXIT_ENABLED=1
STOP_LOSS_ENABLED=1

# 2호 전략 (PRD 5.5-C) — 직전 20거래일 KODEX 200 장중 평균이 0 이상이면 KODEX 200,
# 음수이면 KODEX 인버스를 결정 시각에 시장가로 산다. 매일 둘 중 하나를 산다.
# 자동 중단 — ETF 매매 건별 순수익률 누적합이 -이 값(%) 이하가 되면 매수를 멈추고 메일로 알린다.
# 누적은 ETF_START_DATE(YYYY-MM-DD)부터 센다(비우면 처음부터). 다시 시작하려면 둘 중 하나를 바꾼다.
ETF_KILL_LOSS_PERCENT=5
ETF_START_DATE=

# 자금 배분 — 예수금 중 매매에 투입할 비율(%, 10~100 10단위). 이 금액 전부를 오늘의 ETF 1종목에 쓴다.
INVESTABLE_RATIO_PERCENT=50

# 결정 시각과 매수 안전망 시각 (HH:MM) — UI에는 값만 표시되고, 바꾸려면 여기를 고친 뒤
# 프로그램을 다시 시작한다. 결정 시각에 곧바로 시장가 매수가 나가고, 매수 시각은 그 사이
# 엔진이 재시작돼 결정이 사라진 날의 안전망이다. 결정은 개장(09:00) 후, 매수는 결정보다
# 3분 이상 뒤여야 한다. 어기면 엔진이 시작되지 않는다.
RECOMMEND_TIME=09:05
BUY_TIME=09:10

# 손절 판정(및 AI 매도 판단 프롬프트·UI의 합산 순손익 표시)에 반영할 비용 (단위: %)
COMMISSION_PERCENT=0.015   # 매매수수료 (매수·매도 동일 적용)
TAX_PERCENT=0.20           # 주식 증권거래세+농특세 — ETF 손절 판정에는 쓰지 않는다(면제)
SLIPPAGE_PERCENT=0.1       # 시장가 청산 시 불리하게 밀리는 정도 추정치

# 장애 대응: 장중 예외 발생 시 "close_all"(포지션 정리 후 정지) | "hold"(정지만)
EMERGENCY_ACTION=hold

# LLM 연동 — AI 매도 판단 (Anthropic Claude API)
# 키는 UI "계좌 / API 설정"의 'Anthropic Key' 칸에서도 수정할 수 있다. 모델명은 이 파일 전용이다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# 실전 계좌 사용 시 이 값을 정확히 입력해야 시스템이 실행됩니다.
# LIVE_TRADE_CONFIRMED=YES_I_UNDERSTAND
